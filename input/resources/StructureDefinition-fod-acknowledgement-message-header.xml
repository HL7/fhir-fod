<?xml version="1.0" encoding="UTF-8"?>
<StructureDefinition xmlns="http://hl7.org/fhir" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://hl7.org/fhir ../../input-cache/schemas/R4/fhir-single.xsd">
  <id value="fod-acknowledgement-message-header"/>
  <url value="http://somewhere.org/fhir/us/fod/StructureDefinition/fod-acknowledgement-message-header"/>
  <name value="FODAcknowledgementMessageHeader"/>
  <title value="Fact of Death Acknowledgement Message Header"/>
  <status value="draft"/>
  <experimental value="false"/>
  <date value="2026-08-07"/>
  <publisher value="HL7 International - Public Health Work Group"/>
  <description value="The header of a message acknowledging a fact-of-death notification. It echoes the event code of the notification being acknowledged and identifies that notification through MessageHeader.response.identifier."/>
  <fhirVersion value="4.0.1"/>
  <kind value="resource"/>
  <abstract value="false"/>
  <type value="MessageHeader"/>
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/MessageHeader"/>
  <derivation value="constraint"/>
  <differential>
    <element id="MessageHeader.event[x]">
      <path value="MessageHeader.event[x]"/>
      <short value="The event code of the notification being acknowledged"/>
      <type>
        <code value="Coding"/>
      </type>
      <binding>
        <strength value="required"/>
        <valueSet value="http://somewhere.org/fhir/us/fod/ValueSet/fod-notification-event-vs"/>
      </binding>
      <mustSupport value="true"/>
    </element>
    <element id="MessageHeader.source">
      <path value="MessageHeader.source"/>
      <mustSupport value="true"/>
    </element>
    <element id="MessageHeader.response">
      <path value="MessageHeader.response"/>
      <min value="1"/>
      <mustSupport value="true"/>
    </element>
    <element id="MessageHeader.response.identifier">
      <path value="MessageHeader.response.identifier"/>
      <short value="The MessageHeader.id of the notification being acknowledged. Senders SHOULD set that id to their notification's Bundle.identifier value so that the two are interchangeable when reconciling."/>
      <mustSupport value="true"/>
    </element>
    <element id="MessageHeader.response.code">
      <path value="MessageHeader.response.code"/>
      <short value="Whether the notification was processed. A notification that was received cleanly but matched nothing is 'ok'; the match outcome is carried separately."/>
      <mustSupport value="true"/>
    </element>
    <element id="MessageHeader.response.details">
      <path value="MessageHeader.response.details"/>
      <short value="The match outcome reported for this notification"/>
      <min value="1"/>
      <type>
        <code value="Reference"/>
        <targetProfile value="http://somewhere.org/fhir/us/fod/StructureDefinition/fod-match-outcome"/>
      </type>
      <mustSupport value="true"/>
    </element>
    <element id="MessageHeader.focus">
      <path value="MessageHeader.focus"/>
      <short value="Not used on an acknowledgement. An acknowledgement SHALL NOT echo decedent content back to the sender."/>
      <max value="0"/>
    </element>
  </differential>
</StructureDefinition>
