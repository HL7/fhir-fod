  <entry>
    <fullUrl value="urn:uuid:c2d3e4f5-0617-4829-9a3b-4c5d6e7f8091"/>
    <resource>
      <Observation>
        <id value="fod-death-date-home-example"/>
        <meta>
          <profile value="http://somewhere.org/fhir/us/fod/StructureDefinition/fod-death-date"/>
        </meta>
        <extension url="http://hl7.org/fhir/StructureDefinition/event-location">
          <valueReference>
            <reference value="urn:uuid:d3e4f506-1728-493a-ab4c-5d6e7f809102"/>
          </valueReference>
        </extension>
        <status value="final"/>
        <code>
          <coding>
            <system value="http://loinc.org"/>
            <code value="81956-5"/>
            <display value="Date+time of death"/>
          </coding>
        </code>
        <subject>
          <reference value="urn:uuid:b1c2d3e4-f506-4718-892a-3b4c5d6e7f80"/>
        </subject>
        <!-- The day and time of death are not known. The dateTime carries the precision that is
             known, and the VRCL partial date/time extension states explicitly why the rest is absent. -->
        <valueDateTime value="2026-06">
          <extension url="http://hl7.org/fhir/us/vr-common-library/StructureDefinition/Extension-partial-date-time-vr">
            <extension url="year">
              <valueUnsignedInt value="2026"/>
            </extension>
            <extension url="month">
              <valueUnsignedInt value="6"/>
            </extension>
            <extension url="day">
              <valueUnsignedInt>
                <extension url="http://hl7.org/fhir/StructureDefinition/data-absent-reason">
                  <valueCode value="unknown"/>
                </extension>
              </valueUnsignedInt>
            </extension>
            <extension url="time">
              <valueTime>
                <extension url="http://hl7.org/fhir/StructureDefinition/data-absent-reason">
                  <valueCode value="unknown"/>
                </extension>
              </valueTime>
            </extension>
          </extension>
        </valueDateTime>
        <method>
          <coding>
            <system value="http://hl7.org/fhir/us/vrdr/CodeSystem/vrdr-date-of-death-determination-methods-cs"/>
            <code value="approximate"/>
            <display value="Approximate"/>
          </coding>
        </method>
        <component>
          <code>
            <coding>
              <system value="http://loinc.org"/>
              <code value="58332-8"/>
              <display value="Location of death"/>
            </coding>
          </code>
          <valueCodeableConcept>
            <coding>
              <system value="http://snomed.info/sct"/>
              <code value="440081000124100"/>
              <display value="Death in home"/>
            </coding>
          </valueCodeableConcept>
        </component>
      </Observation>
    </resource>
  </entry>
